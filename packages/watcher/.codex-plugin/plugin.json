{
  "name": "project-watcher",
  "version": "0.1.0",
  "description": "Shared GitHub project watcher with direct active and idle Codex notifications.",
  "skills": "./skills/",
  "hooks": {
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "statusMessage": "Owner-write guard: refuse plain gh writes",
              "type": "command",
              "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/owner-write-guard.sh\""
            }
          ]
        }
      ],
      "SessionEnd": [
        {
          "hooks": [
            {
              "statusMessage": "Project watcher: stop the Codex adapter",
              "type": "command",
              "command": "bun \"${PLUGIN_ROOT}/src/codex-watch.ts\" --hook --stop"
            }
          ]
        }
      ],
      "SessionStart": [
        {
          "hooks": [
            {
              "statusMessage": "Project watcher: start the Codex adapter",
              "type": "command",
              "command": "bun \"${PLUGIN_ROOT}/src/codex-watch.ts\" --hook"
            }
          ]
        }
      ]
    }
  }
}
