{
  "name": "household-brain-workspace",
  "description": "Everything in our household that is due on a date, by category.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "Unlicense",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun --env-file=apps/web/.env.production --env-file=apps/web/.env.production.local apps/web/dev.ts",
    "build": "nx run @household-brain/web:build",
    "lint": "nx run-many -t lint:oxlint lint:packages lint:fallow",
    "lint:oxlint": "oxlint",
    "lint:packages": "npmPkgJsonLint -c npmpackagejsonlint.config.ts . 'apps/*' 'packages/*'",
    "lint:fallow": "fallow dead-code && fallow dupes",
    "lint:fix": "oxlint --fix && npmPkgJsonLint -c npmpackagejsonlint.config.ts --fix . 'apps/*' 'packages/*'",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t typecheck test",
    "test:rules": "bun test tests/rules",
    "test:emulated": "bun packages/tooling/src/e2e-hosting-config.ts && nx run @household-brain/web:build:e2e && firebase emulators:exec --config firebase.e2e.json --only auth,firestore,hosting --project demo-household-brain \"bun run test:rules && bun run --filter @household-brain/web test:e2e\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-household-brain"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@nx/playwright": "23.3.0",
    "@playwright/test": "1.64.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint-plugin-better-tailwindcss": "4.9.0",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "fallow": "3.33.1",
    "firebase": "13.0.0",
    "firebase-tools": "15.33.0",
    "npm-package-json-lint": "11.0.0",
    "nx": "23.3.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  },
  "nx": {
    "includedScripts": [
      "lint:oxlint",
      "lint:packages",
      "lint:fallow"
    ],
    "targets": {
      "typecheck": {
        "command": "tsc"
      }
    }
  },
  "trustedDependencies": [
    "trust-no-install-scripts"
  ]
}
