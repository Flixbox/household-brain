# Public Firebase web config for the household-brain-sf project. None of these values are secret:
# they identify the project, and access is enforced by the Firestore rules and the allowlist.
# Forks: override them in .env.production.local (gitignored) with your own project's values.
VITE_FIREBASE_API_KEY=AIzaSyCgFf_JeoX6kN2VmRl4Y5o-VA7NrK43gG0
# The hosting domain, not the default .firebaseapp.com, so sign-in works in iOS home-screen apps.
VITE_FIREBASE_AUTH_DOMAIN=household-brain-sf.web.app
VITE_FIREBASE_PROJECT_ID=household-brain-sf
VITE_FIREBASE_MESSAGING_SENDER_ID=1094438100532
VITE_FIREBASE_APP_ID=1:1094438100532:web:9aee36a4c884eae4927461
# OAuth client id of the "Web client (auto created by Google Service)"; filled in once it exists.
VITE_GOOGLE_CLIENT_ID=
