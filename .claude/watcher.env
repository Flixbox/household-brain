# The project watcher's settings here (#241), read by the plugin's monitor; the environment still wins.
# The agent works on GitHub as the bot (see .ai/AGENTS.md).
GH=agent-gh
SELF=flixbox-ai-agent[bot]
# Dismiss a bot's (CodeRabbit's) change request left on an older commit once the owner approved and
# every review thread is resolved (#285, #292); it reports REVIEW_DISMISSED.
DISMISS_STALE_BOT_REVIEWS=1
