# Build used by the end-to-end tests: talks only to the local Firebase emulators. The demo- project
# prefix makes the emulators refuse to reach any real Google service.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-household-brain.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-household-brain
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=1:0:web:0
VITE_GOOGLE_CLIENT_ID=demo-client-id
VITE_USE_EMULATORS=true
