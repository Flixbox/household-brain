{
  // fallow: unused code, duplication and architecture boundaries (#59). Runs in `bun run lint`.
  // The schema of the installed version: editors complete and check this file against it. fallow
  // reads only JSON(C) or TOML (it is a Rust binary), so there is no typed .ts config.
  "$schema": "./node_modules/fallow/schema.json",
  // `pwa-build` loads the app's config by name and compiles the service worker by path.
  "entry": ["apps/web/pwa.config.ts", "packages/pwa/src/sw.ts"],
  "boundaries": {
    "zones": [
      { "name": "app", "patterns": ["apps/web/**"] },
      { "name": "shell", "patterns": ["packages/shell/src/**"] },
      { "name": "entries", "patterns": ["packages/entries/src/**"] },
      { "name": "firebase", "patterns": ["packages/firebase/src/**"] },
      // Small helpers every package may use (#171); imports nothing of ours.
      { "name": "core", "patterns": ["packages/core/src/**"] },
      // Builds the installable, offline app and registers its service worker; knows no app code.
      { "name": "pwa", "patterns": ["packages/pwa/src/**"] },
      // Repository tooling run by CI and agents (#142): the app never imports it; of ours it imports only core.
      { "name": "tooling", "patterns": ["packages/tooling/src/**"] },
      // The project watcher, a Claude Code plugin installed on its own (#200): it imports nothing of ours.
      { "name": "watcher", "patterns": ["packages/watcher/src/**"] },
      // "Blocked by" links between issues, a Claude Code plugin installed on its own (#256): it imports nothing of ours.
      { "name": "issue-links", "patterns": ["packages/issue-links/src/**"] }
    ],
    "rules": [
      // apps/web connects the features to the shell; nothing imports from it.
      { "from": "app", "allow": ["shell", "entries", "firebase", "pwa", "core"] },
      // The shell knows no features, and features never import from it for wiring.
      { "from": "shell", "allow": ["firebase", "pwa", "core"] },
      { "from": "entries", "allow": ["firebase", "core"] },
      { "from": "firebase", "allow": ["core"] },
      { "from": "core", "allow": [] },
      { "from": "pwa", "allow": ["core"] },
      { "from": "tooling", "allow": ["core"] },
      { "from": "watcher", "allow": [] },
      { "from": "issue-links", "allow": [] }
    ]
  }
}
