{
  "name": "@household-brain/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "Unlicense",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "tsc -b && bun --bun vite build && pwa-build dist",
    "preview": "bun --bun vite preview",
    "typecheck": "tsc -b",
    "test": "bun test --pass-with-no-tests src",
    "build:e2e": "bun --bun vite build --mode e2e --outDir dist-e2e && pwa-build dist-e2e",
    "test:e2e": "nx run @household-brain/web:playwright"
  },
  "dependencies": {
    "@household-brain/core": "workspace:*",
    "@household-brain/entries": "workspace:*",
    "@household-brain/firebase": "workspace:*",
    "@household-brain/pwa": "workspace:*",
    "@household-brain/shell": "workspace:*",
    "@nanostores/react": "2.0.1",
    "firebase": "13.0.0",
    "nanostores": "1.5.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "wouter": "3.13.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "4.3.3"
  }
}
