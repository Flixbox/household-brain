{
  "name": "@household-brain/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "Unlicense",
  "scripts": {
    "build": "bun --env-file=.env.production --env-file=.env.production.local build.ts production dist && pwa-build dist",
    "typecheck": "tsc -b",
    "build:e2e": "bun --env-file=.env.e2e build.ts e2e dist-e2e && pwa-build dist-e2e",
    "test:e2e": "nx run @household-brain/web:playwright"
  },
  "dependencies": {
    "@household-brain/core": "workspace:*",
    "@household-brain/entries": "workspace:*",
    "@household-brain/firebase": "workspace:*",
    "@household-brain/pwa": "workspace:*",
    "@household-brain/shell": "workspace:*",
    "@nanostores/react": "2.0.1",
    "firebase": "13.1.0",
    "nanostores": "1.5.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "wouter": "3.13.0"
  },
  "devDependencies": {
    "bun-plugin-tailwind": "0.1.2",
    "tailwindcss": "4.3.3"
  }
}
