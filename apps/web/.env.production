# Public Firebase web config for the household-brain-sf project. None of these values are secret:
# they identify the project, and access is enforced by the Firestore rules and the allowlist.
# Forks: override them in .env.production.local (gitignored) with your own project's values.
BUN_PUBLIC_FIREBASE_API_KEY=AIzaSyCgFf_JeoX6kN2VmRl4Y5o-VA7NrK43gG0
# The hosting domain, not the default .firebaseapp.com, so sign-in works in iOS home-screen apps.
BUN_PUBLIC_FIREBASE_AUTH_DOMAIN=household-brain-sf.web.app
BUN_PUBLIC_FIREBASE_PROJECT_ID=household-brain-sf
BUN_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1094438100532
BUN_PUBLIC_FIREBASE_APP_ID=1:1094438100532:web:9aee36a4c884eae4927461
# OAuth client id of the "Web client (auto created by Google Service)" (public by design).
BUN_PUBLIC_GOOGLE_CLIENT_ID=1094438100532-g343f559kmdca940iudsa4iurrju65il.apps.googleusercontent.com
