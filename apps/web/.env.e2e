# Build used by the end-to-end tests: talks only to the local Firebase emulators. The demo- project
# prefix makes the emulators refuse to reach any real Google service.
BUN_PUBLIC_FIREBASE_API_KEY=demo-api-key
BUN_PUBLIC_FIREBASE_AUTH_DOMAIN=household-brain.test
BUN_PUBLIC_FIREBASE_PROJECT_ID=demo-household-brain
BUN_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=0
BUN_PUBLIC_FIREBASE_APP_ID=1:0:web:0
BUN_PUBLIC_GOOGLE_CLIENT_ID=demo-client-id
BUN_PUBLIC_USE_EMULATORS=true
