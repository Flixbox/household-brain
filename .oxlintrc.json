{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc",
    "import"
  ],
  "jsPlugins": [
    "@stylistic/eslint-plugin"
  ],
  "categories": {
    "correctness": "error",
    "nursery": "error",
    "pedantic": "error",
    "perf": "error",
    "restriction": "error",
    "style": "error",
    "suspicious": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/forbid-component-props": ["error", { "forbid": [{ "propName": "className", "allowedFor": ["Link"] }] }], // router links are styled like anchors
    "import/consistent-type-specifier-style": "off", // fights no-import-type-side-effects; verbatimModuleSyntax already enforces correct type imports
    "eslint/sort-imports": ["error", { "ignoreDeclarationSort": true }], // members stay sorted; module order is left to the author
    "eslint/new-cap": ["error", { "capIsNewExceptions": ["VitePWA"] }],
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "react/react-in-jsx-scope": "off", // the automatic JSX runtime needs no React import
    "@stylistic/indent": [
      "error",
      2
    ],
    "@stylistic/quotes": [
      "error",
      "single",
      {
        "avoidEscape": true
      }
    ],
    "@stylistic/jsx-quotes": [
      "error",
      "prefer-double"
    ],
    "@stylistic/semi": [
      "error",
      "never"
    ],
    "@stylistic/comma-dangle": [
      "error",
      "always-multiline"
    ],
    "@stylistic/comma-spacing": "error",
    "@stylistic/object-curly-spacing": [
      "error",
      "always"
    ],
    "@stylistic/array-bracket-spacing": [
      "error",
      "never"
    ],
    "@stylistic/arrow-parens": [
      "error",
      "as-needed"
    ],
    "@stylistic/arrow-spacing": "error",
    "@stylistic/brace-style": [
      "error",
      "1tbs",
      {
        "allowSingleLine": true
      }
    ],
    "@stylistic/key-spacing": "error",
    "@stylistic/keyword-spacing": "error",
    "@stylistic/space-before-blocks": "error",
    "@stylistic/space-infix-ops": "error",
    "@stylistic/eol-last": "error",
    "@stylistic/no-trailing-spaces": "error",
    "@stylistic/no-multiple-empty-lines": [
      "error",
      {
        "max": 1,
        "maxEOF": 0
      }
    ],
    "@stylistic/member-delimiter-style": [
      "error",
      {
        "multiline": {
          "delimiter": "none"
        },
        "singleline": {
          "delimiter": "comma",
          "requireLast": false
        }
      }
    ],
    "@stylistic/type-annotation-spacing": "error",
    "@stylistic/jsx-indent-props": [
      "error",
      2
    ],
    "@stylistic/jsx-closing-bracket-location": "error",
    "@stylistic/jsx-self-closing-comp": "error",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": [
          "**/*.css"
        ]
      }
    ],
    "no-restricted-globals": [
      "error",
      {
        "name": "Date",
        "message": "Date is banned: use Temporal (README section 9)."
      }
    ],
    "oxc/no-async-await": "off", // async/await is the normal way to write async code
    "oxc/no-rest-spread-properties": "off", // object spread is standard since ES2018
    "oxc/no-optional-chaining": "off", // optional chaining is standard since ES2020
    "import/no-named-export": "off", // named exports are the convention (conflicts with no-default-export)
    "import/prefer-default-export": "off", // conflicts with no-default-export
    "import/group-exports": "off", // exports stay next to what they export
    "import/exports-last": "off", // exports stay next to what they export
    "import/no-relative-parent-imports": "off", // the src tree is small, parent imports are fine
    "react/jsx-no-literals": "off", // no i18n layer, plain text in JSX is fine
    "react/jsx-max-depth": "off", // layout depth is a design choice, not a defect
    "eslint/no-undef": "off", // TypeScript already checks undefined names
    "eslint/func-style": "off", // declarations and arrow functions are both used deliberately
    "eslint/one-var": "off", // one declaration per variable is clearer
    "eslint/no-magic-numbers": "off", // too noisy for ports, sizes and timeouts
    "eslint/no-ternary": "off", // ternaries are fine for simple branches
    "typescript/explicit-function-return-type": "off", // return types are inferred
    "typescript/explicit-module-boundary-types": "off", // return types are inferred
    "react/jsx-filename-extension": [
      "error",
      {
        "extensions": [
          ".tsx"
        ]
      }
    ],
    "eslint/no-use-before-define": [
      "error",
      {
        "functions": false
      }
    ]
  },
  "ignorePatterns": [
    "dist",
    "src/routeTree.gen.ts",
    "playwright-report",
    "test-results"
  ],
  "overrides": [
    {
      "files": [
        "src/routes/**"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": [
        "*.config.ts",
        "vite.config.ts",
        "playwright.config.ts",
        "vitest*.config.ts",
        "pwa-assets.config.ts"
      ],
      "rules": {
        "import/no-default-export": "off",
        "import/no-nodejs-modules": "off"
      }
    },
    {
      "files": [
        "tests/**",
        "e2e/**"
      ],
      "rules": {
        "import/no-nodejs-modules": "off"
      }
    },
    {
      "files": [
        "**/*.d.ts"
      ],
      "rules": {
        "import/unambiguous": "off"
      }
    },
    {
      // Test fakes implement async interfaces without needing to await anything, and a test is a
      // linear script: splitting it to satisfy size limits would hide the steps it checks.
      "files": ["**/*.test.ts", "tests/**", "e2e/**"],
      "rules": {
        "eslint/require-await": "off",
        "eslint/max-statements": "off",
        "eslint/max-lines-per-function": "off"
      }
    }
  ]
}
